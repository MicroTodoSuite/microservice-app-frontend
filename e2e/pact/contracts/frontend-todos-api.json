{
  "consumer": { "name": "frontend" },
  "provider": { "name": "todos-api" },
  "interactions": [
    {
      "description": "list todos with a valid bearer token",
      "request": { "method": "GET", "path": "/todos" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json; charset=utf-8" }
      }
    },
    {
      "description": "create a todo with a valid bearer token",
      "request": {
        "method": "POST",
        "path": "/todos",
        "headers": { "Content-Type": "application/json" },
        "body": { "content": "from pact" }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json; charset=utf-8" },
        "body": { "content": "from pact" }
      }
    }
  ],
  "metadata": { "pactSpecification": { "version": "3.0.0" } }
}

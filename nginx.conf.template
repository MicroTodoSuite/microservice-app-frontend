# ngx_otel_module ships with the nginx-unprivileged -otel image (spec 010).
load_module modules/ngx_otel_module.so;

worker_processes 1;

# Non-root NGINX (nginxinc/nginx-unprivileged) can't write to the default
# /run/nginx.pid; this template replaces the whole nginx.conf, so the base
# image's own /tmp/nginx.pid accommodation has to be restated here.
pid /tmp/nginx.pid;

events { worker_connections 1024; }

http {
  include       mime.types;
  default_type  application/octet-stream;
  sendfile      on;
  resolver      ${NGINX_RESOLVER} valid=10s ipv6=off;
  resolver_timeout 5s;

  # Spans leave in batches over OTLP/gRPC, so an unreachable collector costs
  # spans, never requests. entrypoint.sh supplies the endpoint and switches
  # tracing off when none is configured (spec 010).
  otel_exporter {
    endpoint ${OTEL_EXPORTER_OTLP_ENDPOINT};
  }
  otel_service_name frontend;

  map $http_x_request_id $correlation_id {
    default $http_x_request_id;
    ""      $request_id;
  }

  server {
    listen 8080;

    root /usr/share/nginx/html;
    index index.html;
    add_header X-Request-Id $correlation_id always;

    # Keep NGINX healthy while RollingSync creates backend Services later in
    # the same environment step. Variables defer DNS lookup until a request.
    set $auth_api_address ${AUTH_API_ADDRESS};
    set $todos_api_address ${TODOS_API_ADDRESS};

    # SPA fallback
    location / {
      try_files $uri $uri/ /index.html;
    }

    # Only the proxied API calls are traced: nginx starts or continues the
    # request's trace and hands W3C context to the API it forwards to.
    location /login {
      otel_trace ${FRONTEND_OTEL_TRACE};
      otel_trace_context propagate;
      proxy_pass $auth_api_address/login;
      proxy_http_version 1.1;
      proxy_set_header X-Request-Id $correlation_id;
    }

    location /todos {
      otel_trace ${FRONTEND_OTEL_TRACE};
      otel_trace_context propagate;
      proxy_pass $todos_api_address/todos;
      proxy_http_version 1.1;
      proxy_set_header X-Request-Id $correlation_id;
    }

    location = /runtime-config.json {
      alias /tmp/runtime-config.json;
      default_type application/json;
      add_header Cache-Control "no-store" always;
      add_header X-Request-Id $correlation_id always;
    }

    location = /health/startup {
      default_type application/json;
      access_log off;
      return 200 '{"status":"ok"}';
    }

    location = /health/ready {
      default_type application/json;
      access_log off;
      return 200 '{"status":"ok"}';
    }

    location = /health/live {
      default_type application/json;
      access_log off;
      return 200 '{"status":"ok"}';
    }

    location /nginx_status {
      stub_status on;
      access_log off;
      allow 127.0.0.1;
      deny all;
    }
  }
}
